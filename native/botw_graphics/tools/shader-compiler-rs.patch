+    msl_options.version = spirv_cross::msl::Version::V2_3;
+    metal.set_compiler_options(&msl_options).unwrap();
+    let msl = metal.compile().unwrap();
+    std::fs::write(args.output.with_extension("metal"), msl).unwrap();
