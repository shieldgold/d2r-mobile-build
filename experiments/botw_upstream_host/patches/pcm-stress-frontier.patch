+static void check_stress_sequence(const consumer_ctx *c, uint64_t next,
+                                  uint64_t flush_dropped, uint64_t final_flush) {
+    // A gap is observed only when a later data frame crosses it. A periodic
+    // stop/restart may flush the last ring without any later callback consuming
+    // data, so the unobserved suffix can include more than the final stop alone.
+    // Account for the exact decoded sequence frontier, with no missing-frame
+    // tolerance: observed holes plus the whole unseen suffix equal every flush.
+    CHECK(c->expect >= 0 && (uint64_t)c->expect <= next);
+    CHECK(flush_dropped <= next && c->gap_total <= next);
+    uint64_t trailing = next - (uint64_t)c->expect;
+    CHECK(final_flush <= trailing && trailing <= flush_dropped);
+    CHECK_EQ(c->nonzero_frames, next - flush_dropped);
+    CHECK_EQ(c->gap_total, flush_dropped - trailing);
+    CHECK_EQ((uint64_t)c->expect, c->nonzero_frames + c->gap_total);
+    CHECK_EQ(c->backwards, 0);
+    CHECK_EQ(c->order_errors, 0);
+    CHECK_EQ(c->silent_flags_wrong, 0);
+}
