+/* Authenticate the immutable byte stream before key-page or relocation
+ * writes. Hash signed sections incrementally; never copy a full Guest image. */
+static void base_v0_verify_image(module_t *m, const void *const *parts,
+                                 const size_t *lengths, size_t count, int padded) {
+    base_v0_force_layout layout = {m->text_end, m->ro_off, m->data_off,
+        m->patch_off, m->key_page_off, m->key_page_size, {0}};
+    memcpy(layout.key_idx, m->key_idx, sizeof layout.key_idx);
+    if (base_v0_force_image(m->name, &layout, parts, lengths, count, padded))
+        die("base-v0 force image identity mismatch");
+}
