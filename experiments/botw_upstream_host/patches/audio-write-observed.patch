+// Snapshot old FIFO retirement before publishing new frames. Holding the same
+// producer/lifecycle lock excludes a flush/resume between these two operations;
+// the realtime callback remains lock-free and may still consume old frames.
+size_t botw_pcm_write_observed(botw_pcm_sink *s, const int16_t *samples, size_t frames,
+                                unsigned channels, botw_pcm_counters *before) {
+    if (!before) return 0;
+    whole_audio_platform_lock();
+    pcm_get_counters_impl(s, before);
+    size_t written = pcm_write_impl(s, samples, frames, channels);
+    whole_audio_platform_unlock();
+    return written;
+}
 int botw_pcm_set_volume(botw_pcm_sink *s, float volume) {
     whole_audio_platform_lock();
