+static int conditional_draw_commit(conditional_draw_guard *g,const prog_t *p,NvProg *resolved,const botw_conditional_draw_state *expected) {
+    botw_conditional_modes_lock();pthread_mutex_lock(&g_rmu);g->held=1;
+    botw_conditional_draw_state now=conditional_snapshot_locked(p);
+    if (!botw_conditional_state_equal(expected,&now)) { conditional_draw_unlock(g);return 0; }
+    /* Actual attachment publication follows view creation in rp_begin_ex. */
+    if (resolved->sh[1] && (!g_pass.conditional_color0_known || g_pass.conditional_color0_format != now.color0_format)) {
