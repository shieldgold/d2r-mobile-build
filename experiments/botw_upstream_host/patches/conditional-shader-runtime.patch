+        WholeShaderConditionalArtifact *a=[m artifactForInfo:&info state:&now error:&error];
+        if (!a || a!=resolved->sh[info.stage]->artifact) { conditional_draw_unlock(g);return 0; }
+    }
+    return 1; /* Both locks remain held through both stage encodes and draw. */
