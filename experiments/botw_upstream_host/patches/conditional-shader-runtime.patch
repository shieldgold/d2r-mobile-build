+typedef struct { int held; } conditional_draw_guard;
+static void conditional_draw_unlock(conditional_draw_guard *g) {
+    if (g->held) { g->held=0;pthread_mutex_unlock(&g_rmu);botw_conditional_modes_unlock(); }
