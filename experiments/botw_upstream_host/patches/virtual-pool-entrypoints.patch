+       botw_whole_pool_kind_of(target.flags)!=BOTW_WHOLE_POOL_VIRTUAL||
+       count<0||count>BOTW_WHOLE_POOL_MAX_MAPPING_REQUESTS)return 0;
+    if(!count)return mtl_pool_map_virtual(p,0,NULL,error,sizeof error);
+    if(!requests||(size_t)count>SIZE_MAX/sizeof *requests)return 0;
+    size_t bytes=(size_t)count*sizeof *requests;
+    if(!botw_whole_pool_readable(requests,bytes))return 0;
+    NVNmappingRequest *owned=malloc(bytes);if(!owned)return 0;
+    int result=0;
+    if(!botw_whole_pool_read(owned,requests,bytes))goto done;
+    /* Snapshot the complete batch once. Source identities are checked without
+     * trusting a mutated raw object; the sole registry validates kind/device,
+     * alignment, bounds and class before its interval transaction commits. */
+    for(int i=0;i<count;i++)if(owned[i].physicalPool){
+        pool_t physical;
+        if(!botw_whole_pool_read(&physical,owned[i].physicalPool,sizeof physical)||
+           physical.magic!=MAGIC('P','O','O','L')||
+           !mtl_pool_validate(owned[i].physicalPool,physical.mem,physical.size,physical.flags))goto done;
+    }
+    result=mtl_pool_map_virtual(p,count,owned,error,sizeof error);
+done:
+    free(owned);return result;
