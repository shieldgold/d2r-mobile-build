+typedef struct { DirectoryEntry *entries; uint64_t used; unsigned mode; } image_directory_output;
+static int image_directory_emit(void *opaque, const char *name, const botw_romfs_entry *entry) {
+    image_directory_output *output = opaque;
+    DirectoryEntry *result = &output->entries[output->used];
+    dm_guest_write_prepare(result, sizeof *result);
+    memset(result, 0, sizeof *result); strlcpy(result->name, name, sizeof result->name);
+    result->type = entry->is_directory ? ENTRY_DIRECTORY : ENTRY_FILE;
+    result->size = entry->is_directory || (output->mode & OPEN_DIR_NO_FILE_SIZE) ? 0 : (int64_t)entry->size;
+    output->used++; return 0;
+}
