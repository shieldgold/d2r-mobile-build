+/* Count the complete filtered directory without consuming its read cursor. */
+HLE_FORCE("_ZN2nn2fs22GetDirectoryEntryCountEPlNS0_15DirectoryHandleE", "BotW: count the same mounted directory without advancing it", Result, botw_fs_GetDirectoryEntryCount, int64_t *out, uint64_t h) {
+    if (!out) return RES_FS_NULLPTR_ARGUMENT;
+    *out = 0;
+    slot_t *s = handle_lock(h, TAG_DIR, 0);
+    if (!s) return RES_FS_INVALID_HANDLE;
+    Result result = RES_OK;
+    if (s->image) {
+        uint64_t count = 0; botw_romfs_error error;
+        result = image_result(botw_whole_romfs_directory_count(s->image, s->image_path, (unsigned)s->mode, &count, &error));
+        if (!result) *out = (int64_t)count;
+    } else {
+        int fd = openat(s->fd, ".", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        DIR *directory = fd < 0 ? NULL : fdopendir(fd);
+        if (!directory) { int saved = errno; if (fd >= 0) close(fd); errno = saved; result = fail_errno("directory count", "directory"); }
+        else {
+            struct dirent *entry;
+            for (;;) {
+                errno = 0; entry = readdir(directory);
+                if (!entry) { if (errno) result = fail_errno("directory count", "directory"); break; }
+                if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+                struct stat st; if (fstatat(fd, entry->d_name, &st, AT_SYMLINK_NOFOLLOW)) continue;
+                if (((unsigned)s->mode & OPEN_DIR_DIRECTORY) && S_ISDIR(st.st_mode)) (*out)++;
+                else if (((unsigned)s->mode & OPEN_DIR_FILE) && S_ISREG(st.st_mode)) (*out)++;
+            }
+            closedir(directory);
+        }
+    }
+    pthread_rwlock_unlock(&s->lock); return result;
+}
