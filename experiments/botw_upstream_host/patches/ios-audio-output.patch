+
+// The platform registry serializes producer APIs with lifecycle and close. The
+// realtime callback above never enters this registry or acquires its mutex.
+botw_pcm_sink *botw_pcm_open(int audible) {
+    whole_audio_platform_lock();
+    botw_pcm_sink *s = pcm_open_impl(audible);
+    if (s && whole_audio_platform_register_locked(s, pcm_set_active_impl)) {
+        PCM_LOG("cannot register sink for platform lifecycle");
+        pcm_close_impl(s);
+        s = NULL;
+    }
+    whole_audio_platform_unlock();
+    return s;
+}
+int botw_pcm_set_active(botw_pcm_sink *s, int active) {
+    whole_audio_platform_lock();
+    int result = whole_audio_platform_request_locked(s, active);
+    whole_audio_platform_unlock();
+    return result;
+}
+size_t botw_pcm_write(botw_pcm_sink *s, const int16_t *samples, size_t frames, unsigned channels) {
+    whole_audio_platform_lock();
+    size_t written = pcm_write_impl(s, samples, frames, channels);
+    whole_audio_platform_unlock();
+    return written;
+}
+int botw_pcm_set_volume(botw_pcm_sink *s, float volume) {
+    whole_audio_platform_lock();
+    int result = pcm_set_volume_impl(s, volume);
+    whole_audio_platform_unlock();
+    return result;
+}
+void botw_pcm_get_counters(const botw_pcm_sink *s, botw_pcm_counters *out) {
+    whole_audio_platform_lock();
+    pcm_get_counters_impl(s, out);
+    whole_audio_platform_unlock();
+}
+void botw_pcm_close(botw_pcm_sink *s) {
+    whole_audio_platform_lock();
+    // Retire before disposal. A failed Dispose keeps the original callback
+    // storage alive, but the platform must never resume that closed sink.
+    whole_audio_platform_unregister_locked(s);
+    pcm_close_impl(s);
+    whole_audio_platform_unlock();
+}
