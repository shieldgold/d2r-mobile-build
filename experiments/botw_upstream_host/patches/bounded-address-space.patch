+static void mem_initialize_once(void) {
+    botw_whole_address_space chosen; int allocation_error=0;
+    const int physical_ios=TARGET_OS_IOS&&!TARGET_OS_SIMULATOR&&!TARGET_OS_MACCATALYST;
+    if(botw_whole_address_space_reserve(&chosen,physical_ios,&allocation_error)) {
+        LOG("[ERROR] guest AS reservation failed errno=%d",allocation_error);
+        die("reserve guest AS");
+    }
+    // Publish only a fully retained allocation. The original normal memory
