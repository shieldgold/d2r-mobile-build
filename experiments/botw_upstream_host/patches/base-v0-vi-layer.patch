+// The single native VI layer owns the selected scaling policy. Both Metal
+// encoders use one snapshot; shader state and source crop remain unchanged.
+static MTLViewport vi_layer_viewport(double cw, double ch, double dw, double dh) {
+    uint32_t mode = botw_vi_layer_scaling_mode();
+    if (mode == BOTW_VI_SCALE_FIT_TO_LAYER) return (MTLViewport){0, 0, dw, dh, 0, 1};
+    double s = fmin(dw / cw, dh / ch);
+    MTLViewport vp = {floor((dw - cw * s) / 2), floor((dh - ch * s) / 2), round(cw * s), round(ch * s), 0, 1};
+    if (fabs((dw / dh) / ((double)cw / ch) - 1) < 0.01) vp = (MTLViewport){0, 0, dw, dh, 0, 1};
+    return vp;
+}
