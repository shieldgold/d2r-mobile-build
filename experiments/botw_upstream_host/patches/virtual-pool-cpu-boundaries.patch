+/* GPU-only logical storage must not become a raw CPU pointer in consumers
+ * whose ordinary implementation has no virtual mapping/cache contract yet. */
+static int pool_cpu_kind_supported(const NVNmemoryPool *raw) {
+    pool_t pool;
+    return raw&&botw_whole_pool_read(&pool,raw,sizeof pool)&&pool.magic==MAGIC('P','O','O','L')&&
+        mtl_pool_validate(raw,pool.mem,pool.size,pool.flags)&&
+        botw_whole_pool_kind_of(pool.flags)==BOTW_WHOLE_POOL_ORDINARY;
+}
+static void pool_texture_require_cpu(const tex_t *texture) {
+    if(texture&&texture->pool&&!pool_cpu_kind_supported((const NVNmemoryPool*)texture->pool))
+        die("virtual or physical texture CPU access is unsupported");
+}
+
