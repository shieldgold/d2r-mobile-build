+static uint64_t botw_normal_host_call(int num, uint64_t *regs) {
+    (void)regs;
+    if (num == SVC_HOST_BOTW_ALLOCATION_FAILURE)
+        botw_whole_host_account_heap_failure();
+    return 0;
+}
 
