+    for row in rows:
+        require(isinstance(row, dict) and set(row) == {'location', 'component_type'} and
+                type(row['location']) is int and 0 <= row['location'] < 16 and
+                row['component_type'] in ('float', 'int', 'uint') and row['location'] not in result,
+                'invalid or duplicate typed vertex recipe')
+        result[row['location']] = row['component_type']
+    require(rows == attribute_rows(result), 'vertex recipe must use sorted canonical locations')
+    return result
+
+
+def attribute_rows(attributes):
