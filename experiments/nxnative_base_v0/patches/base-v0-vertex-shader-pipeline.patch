+            all(type(k) is int and 0 <= k < 16 and v in ('float', 'int', 'uint')
+                for k, v in attributes.items()), 'invalid typed vertex recipe')
+    return [{'location': k, 'component_type': v} for k, v in sorted(attributes.items())]
