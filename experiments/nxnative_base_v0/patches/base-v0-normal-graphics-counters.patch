 // ================= Render replay =================
 #include "../../host/front.h"
+/* NXNATIVE_NORMAL_GRAPHICS_COUNTERS_BEGIN */
+#if defined(NXNATIVE_NORMAL_POLICY) && NXNATIVE_NORMAL_POLICY
+#define RED_ONCE(...) ((void)0)
+#else
 static int g_red_once[84];
 #define RED_ONCE(k, ...) do { if (!g_red_once[k]++) MLOG("【红】" __VA_ARGS__); } while (0)
+#endif
+/* NXNATIVE_NORMAL_GRAPHICS_COUNTERS_END */
 // NVN vertex streams 0–15 → Metal vertex buffer slots: 0–13 go to 16–29 (30 is the constant fallback buffer), 14 and 15 to 14 and 15. Metal has only the 31 slots 0–30; translated shaders use only buffer(0) (the argument buffer),
 // and the host's own vertex functions read no vertex buffers. 13 Sentinels uses stream 15, and the old 16 + stream went out of range (Metal assertion: buffer index (31) must be < 31)
 #define VB_SLOT(st) ((st) < 14 ? 16 + (st) : (st))
