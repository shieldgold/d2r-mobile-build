+def output_rows(outputs):
+    require(isinstance(outputs, dict) and len(outputs) <= 8 and
+            all(type(k) is int and 0 <= k < 8 and v in ('float', 'int', 'uint') for k, v in outputs.items()),
+            'invalid explicit fragment output recipe')
+    return [{'location': k, 'component_type': v} for k, v in sorted(outputs.items())]
+
+
+def output_map(rows):
+    require(isinstance(rows, list) and len(rows) <= 8, 'fragment recipe must be a bounded list')
+    result = {}
+    for row in rows:
+        require(isinstance(row, dict) and set(row) == {'location', 'component_type'} and
+                type(row['location']) is int and 0 <= row['location'] < 8 and
+                row['component_type'] in ('float', 'int', 'uint') and row['location'] not in result,
+                'invalid or duplicate fragment output recipe')
+        result[row['location']] = row['component_type']
+    require(rows == output_rows(result), 'fragment output recipe must be sorted and canonical')
+    return result
+
+
+def output_facts(outputs):
+    output_rows(outputs)
+    return {k: 'sint' if v == 'int' else v for k, v in outputs.items()}
+
+
+def fragment_outputs(msl):
+    blocks = re.findall(r'struct main0_out\s*\{(.*?)\};', msl, re.S)
+    require(len(blocks) <= 1, 'ambiguous actual fragment output structure')
+    rows = []
+    for ty, location in re.findall(r'(\w+)\s+\w+\s*\[\[color\((\d+)\)\]\]', blocks[0] if blocks else ''):
+        require(re.fullmatch(r'(float|int|uint)[234]?', ty) and int(location) < 8,
+                'actual fragment output has an unsupported type or location')
+        rows.append({'location': int(location), 'msl_type': ty})
+    require(len({row['location'] for row in rows}) == len(rows), 'duplicate actual fragment output')
+    return sorted(rows, key=lambda row: row['location'])
+
