+struct botw_whole_event_producer { event_t *event; };
+static int whole_kernel_problem(char *error, size_t capacity, const char *message) {
+    if (error && capacity) snprintf(error, capacity, "%s", message);
+    return -1;
+}
+static int whole_kernel_free_slots(void) { // G held; no reservation or second table.
+    int count = 0;
+    for (unsigned i = 1; i < MAX_H; ++i) count += g_h[i].type == O_FREE;
+    return count;
+}
+enum botw_whole_handle_kind botw_whole_kernel_handle_kind(uint32_t handle) {
+    unsigned i = handle - 0x1000;
+    pthread_mutex_lock(&G);
+    int type = i && i < MAX_H ? g_h[i].type : O_FREE;
+    pthread_mutex_unlock(&G);
+    switch (type) {
+    case O_THREAD: return BOTW_WHOLE_HANDLE_THREAD;
+    case O_EVENT_R: return BOTW_WHOLE_HANDLE_EVENT_READ;
+    case O_EVENT_W: return BOTW_WHOLE_HANDLE_EVENT_WRITE;
+    case O_TRANSPORT: return BOTW_WHOLE_HANDLE_TRANSPORT;
+    case O_TRANSFER: return (enum botw_whole_handle_kind)BOTW_WHOLE_HANDLE_TRANSFER;
+    default: return BOTW_WHOLE_HANDLE_NONE;
+    }
+}
+int botw_whole_kernel_transport_allocate(void *opaque, const void *owner, uint32_t *out,
+                                        char *error, size_t capacity) {
+    (void)opaque;
+    if (!owner || !out) return whole_kernel_problem(error, capacity, "transport allocation requires owner and output");
+    pthread_mutex_lock(&G);
+    for (unsigned i = 1; i < MAX_H; ++i) {
+        if (g_h[i].type == O_TRANSPORT && g_h[i].obj == owner) {
+            pthread_mutex_unlock(&G);
+            return whole_kernel_problem(error, capacity, "transport owner is already borrowed");
+        }
+    }
+    if (!whole_kernel_free_slots()) {
+        pthread_mutex_unlock(&G);
+        return whole_kernel_problem(error, capacity, "kernel handle capacity exhausted");
+    }
+    *out = h_new(O_TRANSPORT, (void *)owner);
+    pthread_mutex_unlock(&G);
+    return 0;
+}
+int botw_whole_kernel_transport_release(void *opaque, const void *owner, uint32_t handle,
+                                       char *error, size_t capacity) {
+    (void)opaque; unsigned i = handle - 0x1000;
+    pthread_mutex_lock(&G);
+    if (!owner || !i || i >= MAX_H || g_h[i].type != O_TRANSPORT || g_h[i].obj != owner) {
+        pthread_mutex_unlock(&G);
+        return whole_kernel_problem(error, capacity, "transport handle and owner do not match");
+    }
+    g_h[i].type = O_FREE; g_h[i].obj = NULL;
+    pthread_mutex_unlock(&G);
+    return 0;
+}
